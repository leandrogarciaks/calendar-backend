# Variables de entorno del backend (se leen desde .env en index.js)

# Puerto donde escuchará el servidor
PORT=4000

# Cadena de conexión a MongoDB:
#   - Atlas:  mongodb+srv://<usuario>:<contrasena>@<cluster>.mongodb.net/<db>
#   - Local:  mongodb://<host>:<port>/<db>
DB_CNN=mongodb+srv://<usuario>:<contrasena>@<cluster>.mongodb.net/<nombre-base-datos>

# Cadena secreta usada para firmar y verificar los tokens JWT
SECRET_JWT_SEED=<cualquier cadena secreta y aleatoria que uses>
